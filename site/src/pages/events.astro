---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Events from '../components/sections/Events.astro';
import Kicker from '../components/Kicker.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import heroImage from '../assets/events/conference-1.jpg';

// Four kinds of coming-together. Every claim below is drawn from facilities the
// camp already lists — the pool, the bonfire pits, Mwituni's bush dinners, the
// four venues — so nothing here promises a thing we don't have.
const categories = [
  {
    number: '01',
    name: 'Kids',
    tagline: 'Room to run, and a fire to end the day around.',
    body:
      'Birthday parties on the open lawns, school functions and family celebrations — with the guitar-shaped pool to fall into, bush walks in the morning, and the board games lounge for slow afternoons.',
    types: ['Birthdays', 'School functions', 'Family celebrations'],
  },
  {
    number: '02',
    name: 'Romantic',
    tagline: 'Just the two of you, and the mountain.',
    body:
      'Honeymoons, proposals and anniversaries, held quietly. A bush dinner set under the stars at Mwituni, a private deck and a petal-strewn soak, and paths that glow under solar lanterns on the walk back.',
    types: ['Honeymoons', 'Proposals', 'Anniversaries', 'Intimate dinners'],
  },
  {
    number: '03',
    name: 'Corporate',
    tagline: 'Rooms that hold the thinking.',
    body:
      'AGMs, conferences, product launches and team retreats across four venues — from a 15-seat boardroom to a 1,000-guest arena, with full audiovisual support and a team that plans the delegate flow end to end.',
    types: ['AGMs', 'Conferences', 'Launches', 'Retreats'],
    href: '#corporate',
  },
  {
    number: '04',
    name: 'Others',
    tagline: 'Every other reason to gather.',
    body:
      'Graduations, weddings, faith gatherings, galas and festivals. The Mau Mau Hall seats 500 under chandeliers; the Mitini arena opens to 1,000 beneath the mountain — with banquet, theatre and open-floor layouts to suit.',
    types: ['Graduations', 'Weddings', 'Faith gatherings', 'Galas', 'Festivals'],
  },
];
---
<BaseLayout
  title="Events — Birthdays, weddings, conferences & celebrations at Mtalii Bush Camps"
  description="Birthdays, honeymoons, graduations, weddings, AGMs and festivals at the foothills of Mt. Kenya — four venues from a 15-seat boardroom to a 1,000-guest camping arena."
>
  <PageHero
    image={heroImage}
    alt="A rustic executive boardroom at Mtalii with a long timber table under a thatched roof"
    kicker="Gather & Grow"
    title="Every reason to gather, held by the mountain."
    tagline="From 15-seat boardrooms to a 1,000-guest camping arena — a setting for every kind of coming-together."
    crumb="Events"
  />

  <!-- The four kinds of event we host -->
  <section id="occasions" class="relative bg-cream py-24 md:py-36 scroll-mt-24">
    <div class="mx-auto max-w-wide px-6 md:px-10">
      <header class="grid gap-12 md:grid-cols-12 md:gap-20 mb-16 md:mb-24">
        <div class="md:col-span-5">
          <div class="reveal reveal--fade-up"><Kicker tone="coffee">What We Host</Kicker></div>
          <h2 class="reveal reveal--fade-up mt-7 font-display text-display-lg text-forest text-balance" style="--reveal-delay:100ms;">
            Four kinds of coming-together.
          </h2>
        </div>
        <div class="md:col-span-6 md:col-start-7 prose-editorial">
          <div class="reveal reveal--fade-up" style="--reveal-delay:150ms;">
            <p>
              A first birthday, a proposal, an AGM, a graduation &mdash; the mountain holds them all
              the same way. Tell us what you&rsquo;re marking and our team shapes the day around it,
              from the room and the table to the fire it ends beside.
            </p>
          </div>
        </div>
      </header>

      <div class="grid gap-7 md:grid-cols-2">
        {categories.map((cat, i) => (
          <article
            class="reveal reveal--fade-up flex flex-col rounded-card border border-coffee/15 bg-mist p-8 md:p-10 transition-all duration-500 ease-editorial hover:-translate-y-1 hover:shadow-soft"
            style={`--reveal-delay:${(i % 2) * 100}ms;`}
          >
            <span class="font-body text-[0.66rem] font-semibold uppercase tracking-[0.32em] text-coffee-light">
              {cat.number}
            </span>
            <h3 class="mt-4 font-display text-3xl md:text-4xl text-forest leading-tight">{cat.name}</h3>
            <p class="mt-2 font-display italic text-lg text-coffee leading-snug">{cat.tagline}</p>
            <p class="mt-5 font-body text-ink/75 leading-relaxed">{cat.body}</p>

            <ul class="mt-7 flex flex-wrap gap-2">
              {cat.types.map((type) => (
                <li class="rounded-full border border-coffee/15 bg-cream px-3 py-1.5 font-body text-[0.66rem] font-semibold uppercase tracking-[0.08em] text-coffee">
                  {type}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-7">
              <a
                href={cat.href ?? '/contact?interest=Meetings%20%26%20Events'}
                class="group/cta inline-flex items-center gap-2 font-body text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest transition-colors hover:text-coffee"
              >
                {cat.href ? 'See the venues' : `Plan a ${cat.name.toLowerCase()} event`}
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform duration-500 ease-editorial group-hover/cta:translate-x-1">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Corporate deep-dive + the four venues and their capacities -->
  <Events />

  <FinalCTA />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Dining from '../components/sections/Dining.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import heroImage from '../assets/dining/outdoor-dining.jpg';
---
<BaseLayout
  title="Dine — Six restaurants & two bars at Mtalii Bush Camps, Nanyuki"
  description="Six tables and two bars — Mwamba, Elephant Salt Lick Italian Restaurant, Hungry Lions, Mwituni Bush Restaurant, Globetrotters Street Kitchen, the Cowboy BBQ & Smoke House, Globetrotters Street Bar and the Mtalii Lounge Bar."
>
  <PageHero
    image={heroImage}
    alt="Outdoor dining under a canopy of trees at Mtalii"
    kicker="Taste the Wild"
    title="Six tables, two bars, every one a different conversation."
    tagline="From a continental buffet with Mt. Kenya views to a bush dinner under the stars — and a nightcap to follow."
    crumb="Dine"
  />
  <Dining />
  <FinalCTA />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Dining from '../components/sections/Dining.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import heroImage from '../assets/dining/outdoor-dining.jpg';
---
<BaseLayout
  title="Dine — Five restaurants & bars at Mtalii Bush Camps, Nanyuki"
  description="Five tables at the foothills of Mt. Kenya — Mwamba Restaurant, Hungry Lions Café, Globetrotters Street Bar, Cowboys Steakhouse and Jungle Stars."
>
  <PageHero
    image={heroImage}
    alt="Outdoor dining under a canopy of trees at Mtalii"
    kicker="Taste the Wild"
    title="Five tables, every one a different conversation."
    tagline="From continental themed buffets to steaks, seafood and Asian plates — and a nightcap to follow."
    crumb="Dine"
  />
  <Dining />
  <FinalCTA />
</BaseLayout>

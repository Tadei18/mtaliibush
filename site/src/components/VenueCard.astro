---
import { Image } from 'astro:assets';

interface Props {
  number?: string;
  name: string;
  tagline?: string;
  capacity?: string;
  tone?: 'cream' | 'dark';
  /** Optional venue photo, shown flush at the top of the card. */
  image?: ImageMetadata;
  alt?: string;
}
const { number, name, tagline, capacity, tone = 'cream', image, alt = '' } = Astro.props;
const isDark = tone === 'dark';
---
<article class={`reveal reveal--fade-up group relative flex flex-col overflow-hidden rounded-card border transition-all duration-500 ease-editorial hover:-translate-y-1 hover:shadow-soft ${isDark ? 'border-cream/15 bg-forest-deep text-cream' : 'border-coffee/15 bg-cream text-ink'}`}>
  {image && (
    <figure class="relative aspect-[4/3] overflow-hidden bg-mist">
      <Image
        src={image}
        alt={alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 23vw, (min-width: 768px) 45vw, 90vw"
        quality={78}
        format="webp"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-editorial group-hover:scale-[1.05]"
      />
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent"></span>
    </figure>
  )}
  <div class={`flex flex-1 flex-col gap-4 p-7 md:p-8 ${image ? '' : 'md:p-9'}`}>
    {number && (
      <span class={`font-body text-[0.66rem] font-semibold uppercase tracking-[0.32em] ${isDark ? 'text-sand' : 'text-coffee-light'}`}>
        {number}
      </span>
    )}
    <h3 class={`font-display text-2xl md:text-3xl leading-tight ${isDark ? 'text-cream' : 'text-forest'}`}>{name}</h3>
    {tagline && (
      <p class={`-mt-1 font-display italic text-lg leading-snug ${isDark ? 'text-sand' : 'text-coffee'}`}>{tagline}</p>
    )}
    {capacity && (
      <span class={`inline-flex items-center gap-2 font-body text-[0.72rem] uppercase tracking-[0.24em] font-semibold ${isDark ? 'text-sand' : 'text-forest'}`}>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1" />
        </svg>
        {capacity}
      </span>
    )}
    <div class={`mt-2 font-body leading-relaxed ${isDark ? 'text-cream/80' : 'text-ink/75'}`}>
      <slot />
    </div>
  </div>
</article>

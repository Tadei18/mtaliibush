---
/**
 * Enquiry form — posts to /send-enquiry.php (PHP + SMTP handler on cPanel).
 *
 * Progressive enhancement:
 *   - The <form> has action="/send-enquiry.php" method="post" so it works as a
 *     plain HTML POST even with JS disabled (the PHP handler returns JSON; a
 *     no-JS browser would just show that JSON, but the submission still sends).
 *   - With JS, we intercept submit, validate client-side, and post via fetch()
 *     to show an inline success/error state without a page reload.
 *
 * A hidden "bot-field" honeypot traps spam bots (the PHP handler silently
 * drops any submission where it is filled).
 */

// WhatsApp + email fallbacks shown if sending fails.
const waNumber = '254718045869';
const infoEmail = 'info@mtaliibushcamps.com';

const interests = [
  'Stay',
  'Meetings & Events',
  'Spa & Wellness',
  'Dining',
  'Honeymoon / Special Occasion',
  'Other',
];
---
<form
  id="enquiry-form"
  action="/send-enquiry.php"
  method="post"
  class="grid gap-7"
>
  <!-- Honeypot: real users never see or fill this; bots often do. -->
  <div class="enquiry-honeypot" aria-hidden="true">
    <label>
      Leave this field empty
      <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="grid gap-7 md:grid-cols-2">
    <label class="block">
      <span class="enquiry-label">Full Name</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        class="enquiry-input"
        placeholder="Jane Wanjiku"
        aria-describedby="err-name"
      />
      <span id="err-name" class="enquiry-error" hidden></span>
    </label>
    <label class="block">
      <span class="enquiry-label">Email</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        class="enquiry-input"
        placeholder="you@example.com"
        aria-describedby="err-email"
      />
      <span id="err-email" class="enquiry-error" hidden></span>
    </label>
  </div>

  <div class="grid gap-7 md:grid-cols-2">
    <label class="block">
      <span class="enquiry-label">Phone (optional)</span>
      <input
        type="tel"
        name="phone"
        autocomplete="tel"
        class="enquiry-input"
        placeholder="+254 …"
      />
    </label>
    <label class="block">
      <span class="enquiry-label">Number of Guests</span>
      <input
        type="number"
        name="guests"
        min="1"
        max="500"
        class="enquiry-input"
        placeholder="2"
      />
    </label>
  </div>

  <div class="grid gap-7 md:grid-cols-2">
    <label class="block">
      <span class="enquiry-label">Check-in</span>
      <input type="date" name="check-in" class="enquiry-input" />
    </label>
    <label class="block">
      <span class="enquiry-label">Check-out</span>
      <input type="date" name="check-out" class="enquiry-input" />
    </label>
  </div>

  <label class="block">
    <span class="enquiry-label">I&rsquo;m interested in</span>
    <select name="interest" class="enquiry-input">
      <option value="" disabled selected>Choose one…</option>
      {interests.map((i) => <option value={i}>{i}</option>)}
    </select>
  </label>

  <label class="block">
    <span class="enquiry-label">Tell us about your trip</span>
    <textarea
      name="message"
      rows="5"
      required
      class="enquiry-input enquiry-input--textarea"
      placeholder="A weekend escape, a corporate retreat, a wedding under the stars…"
      aria-describedby="err-message"
    ></textarea>
    <span id="err-message" class="enquiry-error" hidden></span>
  </label>

  <!-- Form-level status (success / error) — announced to screen readers. -->
  <div id="enquiry-status" class="enquiry-status" role="status" aria-live="polite" hidden></div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 pt-2">
    <p class="font-body text-sm text-ink/60 max-w-md">
      We&rsquo;ll reply within one business day. Your details are used only to plan your stay.
    </p>
    <button
      id="enquiry-submit"
      type="submit"
      class="enquiry-submit group relative inline-flex items-center justify-center gap-3 font-body font-semibold uppercase text-[0.72rem] tracking-[0.22em] px-7 py-4 transition-all duration-500 ease-editorial will-change-transform bg-forest text-cream hover:bg-forest-deep hover:shadow-soft disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span class="enquiry-submit__label relative z-10">Send Enquiry</span>
      <span class="relative z-10 inline-flex translate-x-0 transition-transform duration-500 ease-editorial group-hover:translate-x-1" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
  </div>
</form>

<style is:global>
  .enquiry-label {
    display: block;
    font-family: 'Mulish', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #7A4E1B;
    margin-bottom: 0.625rem;
  }
  .enquiry-input {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(96, 60, 12, 0.25);
    padding: 0.625rem 0;
    font-family: 'Mulish', sans-serif;
    font-size: 1.025rem;
    color: #241C12;
    transition: border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .enquiry-input::placeholder { color: rgba(36, 28, 18, 0.35); }
  .enquiry-input:focus {
    outline: none;
    border-bottom-color: #186030;
  }
  .enquiry-input--textarea {
    border: 1px solid rgba(96, 60, 12, 0.25);
    padding: 0.875rem 1rem;
    resize: vertical;
    min-height: 140px;
  }
  .enquiry-input--textarea:focus {
    border-color: #186030;
  }
  select.enquiry-input {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1l5 5 5-5' stroke='%23603C0C' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.25rem center;
    padding-right: 1.5rem;
  }

  /* Visually-hidden honeypot — kept out of the layout and off the a11y tree. */
  .enquiry-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Field-level validation messages. */
  .enquiry-error {
    display: block;
    margin-top: 0.5rem;
    font-family: 'Mulish', sans-serif;
    font-size: 0.8rem;
    color: #B23A2E;
  }
  .enquiry-input[aria-invalid='true'] {
    border-bottom-color: #B23A2E;
  }
  .enquiry-input--textarea[aria-invalid='true'] {
    border-color: #B23A2E;
  }

  /* Form-level status panel. */
  .enquiry-status {
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    font-family: 'Mulish', sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .enquiry-status--success {
    background: rgba(24, 96, 48, 0.08);
    border: 1px solid rgba(24, 96, 48, 0.3);
    color: #145029;
  }
  .enquiry-status--error {
    background: rgba(178, 58, 46, 0.07);
    border: 1px solid rgba(178, 58, 46, 0.3);
    color: #8A2C22;
  }
  .enquiry-status a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
  }
</style>

<script>
  const WA_NUMBER = '254718045869';
  const INFO_EMAIL = 'info@mtaliibushcamps.com';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;

  if (form) {
    // Pre-fill from the homepage enquiry bar (/contact?checkin=…&checkout=…&guests=…).
    const params = new URLSearchParams(window.location.search);
    if ([...params.keys()].length) {
      const setField = (selector: string, value: string | null) => {
        if (!value) return;
        const el = form.querySelector<HTMLInputElement | HTMLSelectElement>(selector);
        if (el) el.value = value;
      };
      setField('input[name="check-in"]', params.get('checkin'));
      setField('input[name="check-out"]', params.get('checkout'));
      setField('input[name="guests"]', params.get('guests'));
      if (params.has('checkin') || params.has('checkout') || params.has('guests')) {
        setField('select[name="interest"]', 'Stay');
      }
    }

    // Progressive enhancement: JS is present, so take over validation + submit.
    form.setAttribute('novalidate', '');

    const submitBtn = document.getElementById('enquiry-submit') as HTMLButtonElement;
    const btnLabel = submitBtn.querySelector('.enquiry-submit__label') as HTMLElement;
    const statusEl = document.getElementById('enquiry-status') as HTMLElement;
    const defaultLabel = btnLabel.textContent ?? 'Send Enquiry';

    type FieldRule = { name: string; test: (v: string) => boolean; message: string };
    const rules: FieldRule[] = [
      { name: 'name', test: (v) => v.trim() !== '', message: 'Please enter your name.' },
      { name: 'email', test: (v) => EMAIL_RE.test(v.trim()), message: 'Please enter a valid email address.' },
      { name: 'message', test: (v) => v.trim() !== '', message: 'Please tell us a little about your trip.' },
    ];

    const fieldEl = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    const errEl = (name: string) => document.getElementById(`err-${name}`);

    const showError = (name: string, message: string) => {
      const input = fieldEl(name);
      const err = errEl(name);
      if (input) input.setAttribute('aria-invalid', 'true');
      if (err) {
        err.textContent = message;
        err.hidden = false;
      }
    };
    const clearError = (name: string) => {
      const input = fieldEl(name);
      const err = errEl(name);
      if (input) input.removeAttribute('aria-invalid');
      if (err) {
        err.textContent = '';
        err.hidden = true;
      }
    };

    // Clear a field's error as the user corrects it.
    rules.forEach(({ name, test }) => {
      const input = fieldEl(name);
      input?.addEventListener('input', () => {
        if (test(input.value)) clearError(name);
      });
    });

    const setStatus = (kind: 'success' | 'error', html: string) => {
      statusEl.innerHTML = html;
      statusEl.classList.remove('enquiry-status--success', 'enquiry-status--error');
      statusEl.classList.add(`enquiry-status--${kind}`);
      statusEl.hidden = false;
    };
    const clearStatus = () => {
      statusEl.hidden = true;
      statusEl.innerHTML = '';
      statusEl.classList.remove('enquiry-status--success', 'enquiry-status--error');
    };

    const errorFallbackHtml = (lead: string) =>
      `${lead} You can also reach us on ` +
      `<a href="https://wa.me/${WA_NUMBER}" target="_blank" rel="noopener noreferrer">WhatsApp</a> ` +
      `or at <a href="mailto:${INFO_EMAIL}">${INFO_EMAIL}</a>.`;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearStatus();

      // Validate required fields; focus the first invalid one.
      let firstInvalid: HTMLElement | null = null;
      for (const { name, test, message } of rules) {
        const input = fieldEl(name);
        if (!input || !test(input.value)) {
          showError(name, message);
          if (!firstInvalid) firstInvalid = input;
        } else {
          clearError(name);
        }
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      // In-flight state.
      submitBtn.disabled = true;
      btnLabel.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        let data: { success?: boolean; error?: string } = {};
        try {
          data = await res.json();
        } catch {
          /* non-JSON response — treat as failure below */
        }

        if (res.ok && data.success) {
          form.reset();
          setStatus(
            'success',
            '<strong>Thank you — your enquiry is on its way.</strong><br />' +
              'We&rsquo;ll get back to you within one business day.',
          );
          statusEl.focus?.();
        } else {
          setStatus(
            'error',
            errorFallbackHtml(
              data.error || 'Sorry, something went wrong while sending your enquiry.',
            ),
          );
        }
      } catch {
        setStatus(
          'error',
          errorFallbackHtml('We couldn&rsquo;t reach the server — please check your connection.'),
        );
      } finally {
        submitBtn.disabled = false;
        btnLabel.textContent = defaultLabel;
      }
    });
  }
</script>

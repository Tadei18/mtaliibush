---
import { Image } from 'astro:assets';
import Kicker from '../Kicker.astro';
import CTAButton from '../CTAButton.astro';
// The same optimised file the Nelion accommodation card uses — it is the one
// jacuzzi shot we hold, and the tubs sit on the tent decks it pictures.
import privateJacuzzi from '../../assets/accommodation/private-jacuzzi.jpg';
---
<section id="jacuzzi" class="relative bg-cream py-24 md:py-36 scroll-mt-24">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <div class="grid items-center gap-12 md:gap-16 lg:grid-cols-12">
      <!-- Feature image -->
      <div class="reveal reveal--scale-image lg:col-span-6">
        <div class="relative overflow-hidden rounded-feature aspect-[4/5] shadow-lift">
          <Image
            src={privateJacuzzi}
            alt="A private outdoor jacuzzi strewn with rose petals on the timber deck of a Mtalii tented suite"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 48vw, 100vw"
            quality={82}
            format="webp"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- Copy -->
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="reveal reveal--fade-up"><Kicker tone="coffee">Warm Water, Open Sky</Kicker></div>
        <h2 class="reveal reveal--fade-up mt-6 font-display text-display-md text-forest text-balance" style="--reveal-delay:100ms;">
          The jacuzzi.
        </h2>
        <p class="reveal reveal--fade-up mt-7 prose-editorial" style="--reveal-delay:200ms;">
          Every tented suite carries its own outdoor soaking tub on a private deck &mdash; cocooned
          by canvas and bush garden, open to the sky above. Warm water, birdsong at first light, and
          nothing overhead after dark but the stars.
        </p>
        <p class="reveal reveal--fade-up mt-5 prose-editorial" style="--reveal-delay:260ms;">
          Ask the team to dress it for the occasion: rose petals on the water, a platter set on the
          bath board, and something cold poured beside it. Best taken slowly, as the light goes.
        </p>
        <div class="reveal reveal--fade-up mt-9" style="--reveal-delay:320ms;">
          <CTAButton href="/contact?interest=Spa%20%26%20Wellness" variant="outline" tone="cream">
            Arrange a soak
          </CTAButton>
        </div>
      </div>
    </div>
  </div>
</section>

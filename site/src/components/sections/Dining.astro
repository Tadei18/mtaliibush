---
import Kicker from '../Kicker.astro';
import DiningCard from '../DiningCard.astro';
// The client's final dining photography. Names and taglines below come straight
// from their branding and are the single source of truth — the /dine page, the
// homepage carousel and this section must not drift from them.
import diningMwamba from '../../assets/dining/dining-mwamba.jpg';
import diningHungryLions from '../../assets/dining/dining-hungry-lions.jpg';
import diningGlobetrotters from '../../assets/dining/dining-globetrotters.jpg';
import diningCowboys from '../../assets/dining/dining-cowboys.jpg';
import diningJungleStars from '../../assets/dining/dining-jungle-stars.jpg';
---
<section id="dine" class="relative bg-mist py-24 md:py-36">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <header class="max-w-3xl mb-16 md:mb-24">
      <div class="reveal reveal--fade-up"><Kicker tone="coffee">Taste the Wild</Kicker></div>
      <h2 class="reveal reveal--fade-up mt-7 font-display text-display-lg text-forest text-balance" style="--reveal-delay:100ms;">
        Five tables. Every one a different conversation with the wild.
      </h2>
      <p class="reveal reveal--fade-up mt-7 prose-editorial" style="--reveal-delay:200ms;">
        We believe every meal should be an experience &mdash; flavourful and memorable. Each of our
        restaurants and bars offers a different taste of the wild, the world, and the warmth of
        African hospitality.
      </p>
    </header>

    <!-- 5 dining venues — 3 up / 2 up grid -->
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      <DiningCard
        image={diningMwamba}
        alt="Mwamba Restaurant — continental themed buffets at Mtalii Bush Camps"
        number="01"
        name="Mwamba Restaurant"
        tagline="Continental themed buffets"
      >
        Pan-African ambiance and an indulgent buffet of global favourites and African classics drawn
        from Laikipia&rsquo;s rich farms, seating 200+ guests. Live cooking stations &mdash; chapati,
        grilled meats, pasta, omelettes &mdash; themed buffet nights, and an elaborate dessert bar.
      </DiningCard>

      <DiningCard
        image={diningHungryLions}
        alt="Hungry Lions Café — Italian and American dishes at Mtalii Bush Camps"
        number="02"
        name="Hungry Lions Café"
        tagline="Italian and American dishes"
      >
        Hand-tossed pizzas and hand-rolled pasta beside stacked burgers and skin-on fries &mdash; the
        Italian and American favourites, done properly and built on Laikipia produce. The perfect
        hideout after a day of wild adventure, served with Mtalii&rsquo;s signature warmth.
      </DiningCard>

      <DiningCard
        image={diningGlobetrotters}
        alt="Globetrotters Street Bar — world-class cocktails, wines, beers and whiskies at Mtalii Bush Camps"
        number="03"
        name="Globetrotters Street Bar"
        tagline="World-class cocktails, wines, beers & whiskies"
      >
        A lively street-bar with the swagger of a Berlin corner pub and a London local &mdash;
        signature cocktails, beers on rotation, a curated wine list and whiskies worth lingering
        over. Big-screen sport when the fixtures matter, and the easy buzz that lands right after a
        day of adventure.
      </DiningCard>

      <DiningCard
        image={diningCowboys}
        alt="Cowboys Steakhouse — steaks and seafood at Mtalii Bush Camps"
        number="04"
        name="Cowboys Steakhouse"
        tagline="Steaks and seafood"
      >
        Thick-cut steaks seared over open flame, with prawns and lobster grilled alongside &mdash;
        fire doing what fire does best. Stay for themed cowboy nights with music, boots and barbecue
        under the stars.
      </DiningCard>

      <DiningCard
        image={diningJungleStars}
        alt="Jungle Stars — Asian dishes, Thai, Japanese and Chinese, at Mtalii Bush Camps"
        number="05"
        name="Jungle Stars"
        tagline="Asian — Thai, Japanese & Chinese"
      >
        Thai heat, Japanese precision and Chinese comfort under one roof &mdash; steaming bowls of
        ramen, sushi cut to order, dim sum baskets and spring rolls, eaten slowly as the light goes
        and the stars come out.
      </DiningCard>
    </div>
  </div>
</section>

---
import Kicker from '../Kicker.astro';
import CTAButton from '../CTAButton.astro';
import AccommodationCard from '../AccommodationCard.astro';
import privateJacuzzi from '../../assets/accommodation/private-jacuzzi.jpg';
import lenanaSuite from '../../assets/accommodation/lenana-suite.jpg';
import villageGoldenHour from '../../assets/accommodation/village-golden-hour.jpg';

// Every tent carries the same appointments (king/twin beds, outdoor soaking
// tub, rainforest shower, private deck) and every village shares a bonfire pit
// at its heart — so the chips below stay true per card, and only the emphasis
// shifts to suit who each village is pitched at.
const chipBase = [
  { icon: 'bath', label: 'Outdoor tub' },
  { icon: 'shower', label: 'Rainforest shower' },
  { icon: 'deck', label: 'Private deck' },
];

const villages = [
  {
    image: privateJacuzzi,
    alt: 'A private outdoor soaking tub strewn with rose petals on the deck of a Mtalii tented suite',
    number: '01',
    name: 'Nelion',
    subtitle: 'The Watchman',
    detailsHref: '/stay#nelion',
    chips: [{ icon: 'bed', label: 'King bed' }, ...chipBase],
    body:
      'Made for two — or one. Intimate canvas suites for honeymooners, couples and solo travellers seeking quiet: a private deck, a star-lit soaking tub, and paths that glow under solar lanterns after dusk.',
  },
  {
    image: lenanaSuite,
    alt: 'A luxury tented suite interior at Mtalii with a king bed dressed in rose petals and safari-style armchairs',
    number: '02',
    name: 'Lenana',
    subtitle: 'The Companion',
    detailsHref: '/stay#lenana',
    chips: [{ icon: 'bed', label: 'King / Twin' }, ...chipBase],
    body:
      'Plush, canvas-wrapped interiors — a hand-dressed king bed, safari armchairs and warm lantern light, cocooned by bush garden as evening falls.',
  },
  {
    image: villageGoldenHour,
    alt: 'Mtalii tented suites spread across the village lawn in golden-hour light, Mount Kenya rising beyond',
    number: '03',
    name: 'Batian',
    subtitle: 'The Elder',
    detailsHref: '/stay#batian',
    chips: [
      { icon: 'bed', label: 'King / Twin' },
      ...chipBase,
      { icon: 'fire', label: 'Bonfire pit' },
    ],
    body:
      'Room to gather. Spacious safari-style suites with space for the whole family — king or twin beds, private decks, and a shared bonfire pit at the heart of the village where stories and roasted treats are passed around after dark.',
  },
];
---
<section id="stay" class="relative bg-cream py-24 md:py-32 scroll-mt-24">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <header class="mb-14 md:mb-20 grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <div class="reveal reveal--fade-up"><Kicker tone="coffee">Stay With Us</Kicker></div>
        <h2 class="reveal reveal--fade-up mt-6 font-display text-display-lg text-forest text-balance" style="--reveal-delay:100ms;">
          Three villages, named for the peaks that hold them.
        </h2>
      </div>
      <div class="md:col-span-4 md:text-right">
        <p class="reveal reveal--fade-up font-body text-ink/70 leading-relaxed md:ml-auto md:max-w-xs" style="--reveal-delay:150ms;">
          Nelion, Lenana and Batian &mdash; each tented village blends authentic bush charm with
          luxurious comfort.
        </p>
      </div>
    </header>

    <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {villages.map((v) => (
        <AccommodationCard
          image={v.image}
          alt={v.alt}
          number={v.number}
          name={v.name}
          subtitle={v.subtitle}
          chips={v.chips}
          detailsHref={v.detailsHref}
        >
          {v.body}
        </AccommodationCard>
      ))}
    </div>

    <div class="reveal reveal--fade-up mt-12 flex flex-col sm:flex-row items-center justify-center gap-4" style="--reveal-delay:120ms;">
      <CTAButton href="/stay" variant="outline" tone="cream">View all accommodation</CTAButton>
      <CTAButton href="/rates" variant="ghost" tone="cream">View rates</CTAButton>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import Kicker from '../Kicker.astro';
import CTAButton from '../CTAButton.astro';
import tentedDining from '../../assets/dining/tented-dining.jpg';
import mtKenyaTerrace from '../../assets/dining/mt-kenya-terrace.jpg';
import bushDinner from '../../assets/dining/bush-dinner.jpg';
import outdoorDining from '../../assets/dining/outdoor-dining.jpg';
import safariTable from '../../assets/dining/safari-table.jpg';

const restaurants = [
  { image: tentedDining, alt: 'Mwamba Restaurant — tented dining surrounded by gardens', number: '01', name: 'Mwamba Restaurant', hook: 'Continental buffet with Mt. Kenya views.' },
  { image: mtKenyaTerrace, alt: 'Little Italy Meets Little Thailand — country-side charm and culinary fire', number: '02', name: 'Little Italy Meets Little Thailand', hook: 'Country-side charm, culinary fire.' },
  { image: bushDinner, alt: 'Mwituni Bush Restaurant — open-air dining under the stars', number: '03', name: 'Mwituni — The Bush Restaurant', hook: 'Where wilderness meets fine dining.' },
  { image: outdoorDining, alt: 'Globetrotters Street Kitchen — global street food under canvas', number: '04', name: 'Globetrotters Street Kitchen', hook: 'The streets of the world, on one plate.' },
  { image: safariTable, alt: 'Cowboy Barbecue & Smoke House — poolside grill and smoke pit', number: '05', name: 'Cowboy Barbecue & Smoke House', hook: 'Where fire meets flavour, poolside.' },
];
---
<section id="dine" class="relative bg-mist py-24 md:py-32 scroll-mt-24">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <header class="mb-12 md:mb-16 min-w-0">
      <div class="reveal reveal--fade-up"><Kicker tone="coffee">Taste the Wild</Kicker></div>
      <h2 class="dine-title reveal reveal--fade-up mt-6 font-display text-forest" style="--reveal-delay:100ms;">
        Five tables, five conversations with the wild.
      </h2>
    </header>
  </div>

  <!-- Carousel: horizontal snap track + subtle overlay arrows -->
  <div class="dine-carousel" data-dine-carousel>
    <!-- Track bleeds to the right edge, aligned left to the container -->
    <div class="dine-track-wrap">
    <ul class="dine-track" data-dine-track role="list">
      {restaurants.map((r) => (
        <li class="dine-card group">
          <a href="/dine" class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-forest focus-visible:outline-offset-4">
            <div class="relative aspect-[3/4] overflow-hidden rounded-card bg-forest-deep">
              <Image
                src={r.image}
                alt={r.alt}
                widths={[400, 600, 800]}
                sizes="(min-width: 768px) 24rem, 80vw"
                quality={80}
                format="webp"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-editorial group-hover:scale-[1.05]"
              />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent"></span>
              <span class="absolute left-5 top-5 font-body text-[0.62rem] font-semibold uppercase tracking-[0.32em] text-cream/80">{r.number}</span>
              <div class="absolute inset-x-5 bottom-5">
                <h3 class="font-display text-2xl text-cream leading-tight">{r.name}</h3>
                <p class="mt-1.5 font-display italic text-sand text-base leading-snug">{r.hook}</p>
                <span class="mt-3 inline-flex items-center gap-2 font-body text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-cream/85">
                  Discover
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform duration-500 ease-editorial group-hover:translate-x-1"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
    </div>

    <!-- Manual nav — subtle frosted arrows overlaying the card edges -->
    <div class="dine-arrows">
      <button type="button" class="dine-arrow dine-arrow--prev" data-dine-prev aria-label="Previous" disabled>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 3L5 9l6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="dine-arrow dine-arrow--next" data-dine-next aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 3l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <div class="mx-auto max-w-wide px-6 md:px-10">
    <div class="reveal reveal--fade-up mt-12 flex justify-center" style="--reveal-delay:120ms;">
      <CTAButton href="/dine" variant="outline" tone="cream">Explore all dining</CTAButton>
    </div>
  </div>
</section>

<style>
  /* One line on large screens (where it fits); wraps gracefully below */
  .dine-title {
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    .dine-title { white-space: nowrap; }
  }

  .dine-track-wrap { width: 100%; }
  .dine-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 1.5rem;
    scrollbar-width: none;
    cursor: grab;
  }
  .dine-track[data-dragging='true'] { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; }
  .dine-track::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) {
    .dine-track { padding-left: max(2.5rem, calc((100vw - 88rem) / 2 + 2.5rem)); padding-right: 2.5rem; gap: 1.5rem; }
  }
  .dine-card {
    flex: 0 0 auto;
    width: 78vw;
    max-width: 22rem;
    scroll-snap-align: start;
  }
  @media (min-width: 768px) { .dine-card { width: 22rem; } }

  /* ── Overlay arrows — quiet frosted glass over the card edges ────────── */
  .dine-carousel { position: relative; }
  .dine-arrows {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(88rem, 100%);
    padding-inline: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none; /* let taps fall through to the cards */
  }
  @media (min-width: 768px) { .dine-arrows { padding-inline: 2.25rem; } }

  .dine-arrow {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: #FBF5EC;
    background: rgba(251, 245, 236, 0.16);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    backdrop-filter: blur(8px) saturate(1.1);
    border: 1px solid rgba(228, 192, 132, 0.55);
    box-shadow: 0 6px 16px -10px rgba(15, 68, 35, 0.6);
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.4s ease, color 0.4s ease;
  }
  @media (min-width: 768px) { .dine-arrow { width: 46px; height: 46px; } }

  /* Quietly raise visibility when the carousel is hovered/focused */
  .dine-carousel:hover .dine-arrow:not(:disabled),
  .dine-carousel:focus-within .dine-arrow:not(:disabled) { opacity: 0.8; }

  /* Direct hover/focus on an arrow → solid cream button */
  .dine-arrow:hover:not(:disabled) {
    opacity: 1;
    transform: scale(1.07);
    background: rgba(251, 245, 236, 0.92);
    color: #186030;
  }
  .dine-arrow:focus-visible {
    opacity: 1;
    outline: 2px solid #E4C084;
    outline-offset: 3px;
  }
  .dine-arrow:disabled { opacity: 0.12; cursor: default; }

  /* No hover (touch) → keep them faintly visible */
  @media (hover: none) {
    .dine-arrow:not(:disabled) { opacity: 0.55; }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const track = document.querySelector<HTMLElement>('[data-dine-track]');
  if (track) {
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-dine-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-dine-next]');
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.dine-card'));
    const behavior: ScrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

    // One-card step, measured from the gap between the first two cards
    const step = () => (cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth * 0.8);
    const atStart = () => track.scrollLeft <= 2;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    // Disable arrows at the ends, dim them
    const updateArrows = () => {
      if (prevBtn) prevBtn.disabled = atStart();
      if (nextBtn) nextBtn.disabled = atEnd();
    };

    prevBtn?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior }));
    nextBtn?.addEventListener('click', () => track.scrollBy({ left: step(), behavior }));

    // Keep arrow state in sync with scroll position (rAF-throttled) + resize
    let raf = 0;
    track.addEventListener('scroll', () => {
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; updateArrows(); });
    }, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    updateArrows();

    // ── Mouse drag-to-scroll (touch uses native scroll) ──────────────────
    let down = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
      track.setAttribute('data-dragging', 'true');
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startScroll - dx;
    });
    const endDrag = () => {
      if (!down) return;
      down = false;
      track.removeAttribute('data-dragging');
      updateArrows();
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    // Suppress the card-link click if the pointer was dragged
    track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
  }
</script>

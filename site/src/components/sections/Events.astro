---
import { Image } from 'astro:assets';
import Kicker from '../Kicker.astro';
import VenueCard from '../VenueCard.astro';
import CTAButton from '../CTAButton.astro';
// Mitini now carries events5 — a real large-scale event (marquee, stage, red
// carpet, seating for hundreds). It reads as the "festivals / large-scale events"
// scale the copy promises far better than a small themed dinner would.
import mitiniEvent from '../../assets/events/events5.jpg';
// Each conference asset is used exactly once on this page — conference-1 carries
// the page hero, so this band takes conference-3 and the venue cards take the rest.
import conference2 from '../../assets/events/conference-2.jpg';
import conference3 from '../../assets/events/conference-3.jpg';
import conference4 from '../../assets/events/conference-4.jpg';
import conference5 from '../../assets/events/conference-5.jpg';

const retreatBeats = [
  {
    title: 'Quiet ground for big thinking',
    body:
      'Boardrooms framed by the mountain. Breakout spaces under canvas. Lawns that turn into open-floor sessions when the room runs out of ideas.',
  },
  {
    title: 'Days designed end-to-end',
    body:
      'Our hospitality team plans your delegate flow — arrivals, dining, breakouts, evening unwind — so you can stay focused on the conversation.',
  },
  {
    title: 'After-hours, on purpose',
    body:
      'Bonfire dinners, sundowner sessions, archery and quad biking — the kind of evenings that bond a team better than another slide deck.',
  },
];
---
<section id="corporate" class="relative bg-mist py-24 md:py-36 scroll-mt-24">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <header class="max-w-3xl mb-16">
      <div class="reveal reveal--fade-up"><Kicker tone="coffee">Corporate</Kicker></div>
      <h2 class="reveal reveal--fade-up mt-7 font-display text-display-lg text-forest text-balance" style="--reveal-delay:100ms;">
        Time away that pays its way back.
      </h2>
      <p class="reveal reveal--fade-up mt-7 prose-editorial" style="--reveal-delay:200ms;">
        Mtalii is built for the kind of retreat where teams arrive a little tense and leave with
        a list of decisions and a few in-jokes &mdash; held together by the mountain, the morning
        air, and unhurried evenings.
      </p>
    </header>

    <!-- A glimpse inside the meeting spaces -->
    <figure class="reveal reveal--scale-image group relative overflow-hidden rounded-card aspect-[16/9] md:aspect-[21/9] mb-16 md:mb-20">
      <Image
        src={conference3}
        alt="An executive boardroom at Mtalii dressed with fresh flowers, opening onto the bush"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        quality={80}
        format="webp"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-editorial group-hover:scale-[1.04]"
      />
    </figure>

    <ul class="grid gap-y-12 md:grid-cols-3 md:gap-x-12">
      {retreatBeats.map((beat, i) => (
        <li class="reveal reveal--fade-up border-t border-coffee/20 pt-7" style={`--reveal-delay:${i * 100}ms;`}>
          <span class="font-body text-[0.66rem] font-semibold uppercase tracking-[0.32em] text-coffee-light">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 font-display text-2xl text-forest">{beat.title}</h3>
          <p class="mt-4 font-body text-ink/75 leading-relaxed">{beat.body}</p>
        </li>
      ))}
    </ul>

    <!-- 4 venue cards -->
    <div id="venues" class="mt-20 md:mt-28 scroll-mt-24">
      <div class="reveal reveal--fade-up mb-10 md:mb-14">
        <Kicker tone="coffee">The Venues</Kicker>
        <h3 class="mt-6 font-display text-display-sm text-forest text-balance">
          Four rooms, from a boardroom of fifteen to an arena of a thousand.
        </h3>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <VenueCard
          number="01"
          name="Mau Mau Conference Hall"
          tagline="Grand. Iconic. Inspiring."
          capacity="Up to 500 guests"
          image={conference4}
          alt="The Mau Mau Conference Hall set with chandeliers and Mt. Kenya through the windows"
        >
          Named in honour of Kenya&rsquo;s liberation heroes. Theatre-style seating, a raised
          40-seater stage, private backstage, and flexible layouts &mdash; banquet, boardroom,
          classroom, open-floor. Perfect for AGMs, faith gatherings, bootcamps, festivals, weddings,
          performances and galas.
        </VenueCard>

        <VenueCard
          number="02"
          name="Uhuru Boardroom"
          tagline="Executive space, quiet focus."
          capacity="15 – 20 guests"
          image={conference2}
          alt="The Uhuru Boardroom — an executive meeting room with bush-view windows and a presentation screen"
        >
          Discreet and well-appointed for VVIP delegations and board-level engagements &mdash; built
          for the kind of conversation that needs no audience.
        </VenueCard>

        <VenueCard
          number="03"
          name="Mzalendo Hall"
          tagline="Flexible flagship."
          capacity="Up to 100 guests"
          image={conference5}
          alt="Mzalendo Hall arranged classroom-style with a projector screen and Mt. Kenya views"
        >
          Mid-sized conferences, workshops and social functions, with full audiovisual support and
          the serene backdrop of Mt.&nbsp;Kenya through the windows.
        </VenueCard>

        <VenueCard
          number="04"
          name="Mitini Camping Arena"
          tagline="Festivals beneath the mountain."
          capacity="Up to 1,000 guests"
          image={mitiniEvent}
          alt="A large-scale event at the Mitini arena, Mtalii Bush Camps — a marquee set with a stage, red carpet and seating for hundreds"
        >
          Expansive, well-curated camping against the backdrop of Mt.&nbsp;Kenya &mdash; ideal for
          festivals, retreats, group getaways, and large-scale events, with bonfire nights and
          outdoor dining under the stars.
        </VenueCard>
      </div>
    </div>

    <div class="reveal reveal--fade-up mt-16" style="--reveal-delay:400ms;">
      <CTAButton href="/contact?interest=Meetings%20%26%20Events" variant="primary" tone="cream">Plan Your Event</CTAButton>
    </div>
  </div>
</section>

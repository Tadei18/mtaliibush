---
import { Image } from 'astro:assets';
import Kicker from '../Kicker.astro';
import VenueCard from '../VenueCard.astro';
import eventGathering from '../../assets/events/event-gathering.jpg';
// Same optimised conference assets the homepage events band uses.
import conference1 from '../../assets/events/conference-1.jpg';
import conference2 from '../../assets/events/conference-2.jpg';
import conference3 from '../../assets/events/conference-3.jpg';
import conference4 from '../../assets/events/conference-4.jpg';
import conference5 from '../../assets/events/conference-5.jpg';
---
<section id="events" class="relative bg-cream py-24 md:py-36">
  <div class="mx-auto max-w-wide px-6 md:px-10">
    <header class="grid gap-12 md:grid-cols-12 md:gap-20 mb-16 md:mb-24">
      <div class="md:col-span-5">
        <div class="reveal reveal--fade-up"><Kicker tone="coffee">Gather & Grow</Kicker></div>
        <h2 class="reveal reveal--fade-up mt-7 font-display text-display-lg text-forest text-balance" style="--reveal-delay:100ms;">
          Meetings, events &amp; team building &mdash; held by the mountain.
        </h2>
      </div>
      <div class="md:col-span-6 md:col-start-7 prose-editorial">
        <div class="reveal reveal--fade-up" style="--reveal-delay:150ms;">
          <p>
            Corporate team building and group retreats designed to inspire collaboration, creativity
            and growth, set among serene landscapes. Three distinct venues plus an expansive camping
            arena &mdash; each shaped for a different kind of gathering.
          </p>
        </div>
      </div>
    </header>

    <!-- A glimpse inside the meeting spaces -->
    <div class="grid gap-4 md:gap-6 md:grid-cols-2 mb-16 md:mb-20">
      <figure class="reveal reveal--scale-image group relative overflow-hidden rounded-card aspect-[4/3]">
        <Image src={conference1} alt="A rustic executive boardroom at Mtalii with a long table and mountain-forest views" widths={[480, 720, 960, 1280]} sizes="(min-width:768px) 46vw, 100vw" quality={80} format="webp" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-editorial group-hover:scale-[1.04]" />
      </figure>
      <figure class="reveal reveal--scale-image group relative overflow-hidden rounded-card aspect-[4/3]" style="--reveal-delay:150ms;">
        <Image src={conference3} alt="An elegant meeting room at Mtalii dressed with fresh flowers and bush views" widths={[480, 720, 960, 1280]} sizes="(min-width:768px) 46vw, 100vw" quality={80} format="webp" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-editorial group-hover:scale-[1.04]" />
      </figure>
    </div>

    <!-- 4 venue cards -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <VenueCard
        number="01"
        name="Mau Mau Conference Hall"
        tagline="Grand. Iconic. Inspiring."
        capacity="Up to 500 guests"
        image={conference4}
        alt="The Mau Mau Conference Hall set with chandeliers and Mt. Kenya through the windows"
      >
        Named in honour of Kenya&rsquo;s liberation heroes. Theatre-style seating, a raised
        40-seater stage, private backstage, and flexible layouts &mdash; banquet, boardroom,
        classroom, open-floor. Perfect for AGMs, faith gatherings, bootcamps, festivals, weddings,
        performances and galas.
      </VenueCard>

      <VenueCard
        number="02"
        name="Uhuru Boardroom"
        tagline="Executive space, quiet focus."
        capacity="15 – 20 guests"
        image={conference2}
        alt="The Uhuru Boardroom — an executive meeting room with bush-view windows and a presentation screen"
      >
        Discreet and well-appointed for VVIP delegations and board-level engagements &mdash; built
        for the kind of conversation that needs no audience.
      </VenueCard>

      <VenueCard
        number="03"
        name="Mzalendo Hall"
        tagline="Flexible flagship."
        capacity="Up to 100 guests"
        image={conference5}
        alt="Mzalendo Hall arranged classroom-style with a projector screen and Mt. Kenya views"
      >
        Mid-sized conferences, workshops and social functions, with full audiovisual support and
        the serene backdrop of Mt.&nbsp;Kenya through the windows.
      </VenueCard>

      <VenueCard
        number="04"
        name="Mitini Camping Arena"
        tagline="Festivals beneath the mountain."
        capacity="Up to 1,000 guests"
        image={eventGathering}
        alt="The Mitini Camping Arena — a large open-air gathering on the lawn beneath Mt. Kenya"
      >
        Expansive, well-curated camping against the backdrop of Mt.&nbsp;Kenya &mdash; ideal for
        festivals, retreats, group getaways, and large-scale events, with bonfire nights and
        outdoor dining under the stars.
      </VenueCard>
    </div>
  </div>
</section>
